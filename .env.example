# Скопіюйте цей файл у .env і впишіть свої значення.
# Файл .env не потрапляє в Git (див. .gitignore).

# Токен Telegram-бота (отримати у @BotFather)
TELEGRAM_BOT_TOKEN=

# ID чату, куди надсилати повідомлення (дізнатися: python integration.py --find-chat-id)
TELEGRAM_CHAT_ID=

# Секрет для перевірки запитів від Telegram на webhook (будь-який довгий рядок)
TELEGRAM_WEBHOOK_SECRET=

# Секрет планувальника: GitHub Actions передає його в заголовку X-Cron-Secret
CRON_SECRET=

# Публічна адреса сервісу (після розгортання на Render)
APP_BASE_URL=http://localhost:8000

# База даних: локально SQLite, у хмарі - PostgreSQL (postgresql://...)
DATABASE_URL=sqlite:///./data/app.db

# Open-Meteo не потребує API-ключа
